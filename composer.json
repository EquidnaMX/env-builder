{
  "name": "equidna/env-builder",
  "description": "CLI and PHAR tool to merge .env fragments and optionally deploy compiled .env files.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.1",
    "symfony/process": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "illuminate/support": "Required only when using Laravel ServiceProvider and Artisan command integration."
  },
  "autoload": {
    "psr-4": {
      "EnvBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EnvBuilder\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/env-builder",
    "bin/env-builder-e2e-test"
  ],
  "extra": {
    "laravel": {
      "providers": [
        "EnvBuilder\\Laravel\\EnvBuilderServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:e2e": "@php bin/env-builder-e2e-test",
    "build:phar": "php -d phar.readonly=0 build.php"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
